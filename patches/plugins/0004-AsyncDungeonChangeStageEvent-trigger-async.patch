Subject: [PATCH 04/12] AsyncDungeonChangeStageEvent trigger async

---
 .../t/me/p1azmer/plugin/dungeons/dungeon/impl/Dungeon.java    | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/impl/Dungeon.java b/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/impl/Dungeon.java
index 1eff244..ca7f248 100644
--- a/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/impl/Dungeon.java
+++ b/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/impl/Dungeon.java
@@ -437,7 +437,9 @@ public class Dungeon extends AbstractConfigHolder<DungeonPlugin> implements ICle
   }
 
   public void cancel(boolean shutdown) {
-    if (!shutdown) DungeonStage.call(this, FREEZE, "cancelled and refresh");
+    if (!shutdown) {
+      CompletableFuture.runAsync(() -> DungeonStage.call(this, FREEZE, "cancelled and refresh")); // Fix AsyncDungeonChangeStageEvent
+    }
 
     RegionHandler regionHandler = this.plugin().getRegionHandler();
     GenerationType generationType = this.getGenerationSettings().getGenerationType();
