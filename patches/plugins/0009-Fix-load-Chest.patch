From 24b1bd497e606c89f881f7432efec3d37f12c817 Mon Sep 17 00:00:00 2001
From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Sun, 28 Jul 2024 12:11:12 +0200
Subject: [PATCH 09/12] Fix load Chest

---
 .../dungeon/modules/impl/ChestModule.java         | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/modules/impl/ChestModule.java b/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/modules/impl/ChestModule.java
index 1e64970..a0b8507 100644
--- a/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/modules/impl/ChestModule.java
+++ b/src/main/java/t/me/p1azmer/plugin/dungeons/dungeon/modules/impl/ChestModule.java
@@ -1,6 +1,7 @@
 package t.me.p1azmer.plugin.dungeons.dungeon.modules.impl;
 
 import lombok.Getter;
+import org.bukkit.Bukkit;
 import org.bukkit.Location;
 import org.bukkit.Material;
 import org.bukkit.block.Block;
@@ -74,12 +75,16 @@ public class ChestModule extends AbstractModule {
     }
 
     FixedMetadataValue metadataValue = new FixedMetadataValue(plugin(), this.getDungeon().getId());
+      List<Block> list = new ArrayList<>();
+      for (Block f : cuboid.getBlocks()) {
+        Bukkit.getRegionScheduler().run(this.plugin(), f.getLocation(), scheduledTask -> {
+          if (f.getType().equals(material)) {
+              f.setMetadata(Keys.DUNGEON_CHEST_BLOCK.getKey(), metadataValue);
+              list.add(f);
+          }});
+      }
     this.blocks.addAll(
-      cuboid.getBlocks()
-            .stream()
-            .filter(f -> f.getType().equals(material))
-            .peek(block -> block.setMetadata(Keys.DUNGEON_CHEST_BLOCK.getKey(), metadataValue))
-            .toList()
+              list
     );
 
     if (this.blocks.isEmpty()) {
